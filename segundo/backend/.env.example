# ============================================
# Database (obligatorio)
# ============================================
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/segundo

# ============================================
# Auth (obligatorio)
# ============================================
# 32+ caracteres. Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=cambiar-por-string-aleatorio-de-32-o-mas-caracteres
JWT_EXPIRE_MINUTES=1440
JWT_REFRESH_EXPIRE_DAYS=7

# ============================================
# LLM Provider — elegir UNO
# ============================================
# Opciones: "groq" (recomendado, gratis con cuota) | "ollama" (local) | "claude" (Anthropic, paga)
LLM_PROVIDER=groq

# Si LLM_PROVIDER=groq (obtener key en https://console.groq.com/keys)
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile

# Si LLM_PROVIDER=claude
ANTHROPIC_API_KEY=sk-ant-...

# ============================================
# Embeddings (opcional)
# ============================================
# Sin esta key se usa un mock determinístico — sirve para dev pero la búsqueda semántica es peor
VOYAGE_API_KEY=

# ============================================
# CORS / Rate limit
# ============================================
CORS_ORIGINS=http://localhost:5173
ASK_RATE_LIMIT=10/minute

# ============================================
# Demo accounts (opcional)
# ============================================
DEMO_OWNER_PASSWORD=cambiar-en-produccion
DEMO_EMPLOYEE_PASSWORD=cambiar-en-produccion
